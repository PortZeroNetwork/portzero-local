# Parallels VM system-test harness (host-side; runs on the macOS host that owns
# the VMs). Import from the top-level justfile. All recipes shell out to
# `prlctl` via vmtest/scripts/vm.sh, so they are macOS-only.
#
# Model:
#   - Every platform is orthogonal: "<name>" (~/Parallels, internal) is the
#     working copy vm-up/vm-test actually boots; "<name> archive" (4TB drive)
#     is a dormant, never-booted clone source. If the internal copy is missing,
#     `vm-test` recovers from the archive (see resolve_effective_vm in vm.sh).
#   - Snapshot names are uniform across every VM/alias: "portzero-golden"
#     (hand-made, powered-off, clean baseline), "portzero-ready" (booted once,
#     running-snapshot reset point), "portzero-built" (provisioned/built,
#     running-snapshot). `vm-up` reverts to golden, boots once, captures ready.
#     Provision once, then `vm-checkpoint <vm> built`; every test does
#     `vm-reset <vm> built` first, so many tests run in ONE session without
#     rebooting from powered-off.
#   - Windows/Linux scripts run by shared-folder path from the guest; nothing
#     is copied in. macOS's Parallels shared folder is SMB-backed and requires
#     an authenticated GUI login the guest never has after a snapshot revert,
#     so macOS instead gets the script (and, since it's artifact-only with no
#     guest toolchain, the host-built binary) pushed in over `prlctl exec`.

_vmtest-help:
    @just --list --list-heading $'VM system-test harness (macOS host):\n'

# List all VMs and their snapshots.
[macos]
vm-list:
    bash vmtest/scripts/vm.sh list

# Enforce one-at-a-time, revert to golden, boot, and capture "<vm>-ready".
# Idempotent: if "<vm>-ready" exists, just resumes it.
[macos]
vm-up vm="Windows 11 Pro":
    bash vmtest/scripts/vm.sh up "{{vm}}"

# Take a RUNNING snapshot "<vm>-<name>" as a per-session reset point (e.g. after
# installing the toolchain / building). Replaces an existing one of that name.
[macos]
vm-checkpoint vm name:
    bash vmtest/scripts/vm.sh checkpoint "{{vm}}" "{{name}}"

# Revert to running snapshot "<vm>-<name>" (default "ready") and wait until ready.
[macos]
vm-reset vm="Windows 11 Pro" name="ready":
    bash vmtest/scripts/vm.sh reset "{{vm}}" "{{name}}"

# Shared by vm-test / vm-test-staging: run one platform, or all three in
# series with a failure on one not skipping the rest, then a summary.
[macos]
_vm-test-series flavor platform="":
    #!/usr/bin/env bash
    set -uo pipefail
    if [ -n "{{platform}}" ]; then
        bash vmtest/scripts/vm.sh test "{{platform}}" "{{flavor}}"
        exit $?
    fi
    declare -A rc
    for p in windows linux macos; do
        bash vmtest/scripts/vm.sh test "$p" "{{flavor}}"
        rc[$p]=$?
    done
    echo ""
    echo "=== vm-test ({{flavor}}) summary ==="
    overall=0
    for p in windows linux macos; do
        if [ "${rc[$p]}" -eq 0 ]; then
            printf "  %-8s PASS\n" "$p"
        else
            printf "  %-8s FAIL (exit %s)\n" "$p" "${rc[$p]}"
            overall=1
        fi
    done
    exit "$overall"

# Run the default e2e smoke test (local overlay tunnel — no cloud, no
# secrets) for one platform, or with no argument run windows, then linux,
# then macos in series. Resets each VM to its "built" checkpoint first;
# vm.sh enforces one VM running at a time, so a bare `just vm-test` never
# has two guests up simultaneously.
#   just vm-test            # all three, in series
#   just vm-test windows
#   just vm-test linux
#   just vm-test macos
[macos]
vm-test platform="":
    just _vm-test-series local "{{platform}}"

# Same as vm-test, but the real cloud-tunnel E2E against staging (registers a
# public tunnel, creates a throwaway staging test account each run). Needs
# the rotated seed token: Windows/Linux read it via the existing MBP-Sidecar
# share, macOS gets it pushed in automatically from the same host file vm.sh
# uses by default (see STAGING_SECRETS_HOST_DEFAULT), or set STAGING_SECRETS
# yourself to override the source file.
#   just vm-test-staging            # all three, in series
#   just vm-test-staging windows
[macos]
vm-test-staging platform="":
    just _vm-test-series staging "{{platform}}"

# Reset to a checkpoint, then run an arbitrary repo script in the guest.
# Advanced/ad-hoc form — `vm-test <platform>` covers the common case.
#   just vm-test-script "Windows 11 Pro" vmtest/scripts/e2e-staging-tunnel.ps1 built
[macos]
vm-test-script vm script checkpoint="built" *ARGS:
    bash vmtest/scripts/vm.sh reset "{{vm}}" "{{checkpoint}}"
    VM_RUN_TIMEOUT=${VM_RUN_TIMEOUT:-360} bash vmtest/scripts/vm.sh run "{{vm}}" "{{script}}" {{ARGS}}

# Run a repo script in the guest WITHOUT resetting (ad-hoc).
[macos]
vm-run vm script *ARGS:
    bash vmtest/scripts/vm.sh run "{{vm}}" "{{script}}" {{ARGS}}

# Raw command in the guest.
[macos]
vm-exec vm +CMD:
    bash vmtest/scripts/vm.sh exec "{{vm}}" {{CMD}}

# Power off a VM.
[macos]
vm-stop vm="Windows 11 Pro":
    bash vmtest/scripts/vm.sh stop "{{vm}}"

# Report what dev tooling is present in the guest.
[macos]
vm-inventory vm="Windows 11 Pro":
    bash vmtest/scripts/vm.sh run "{{vm}}" vmtest/scripts/inventory.ps1

# Download-what's-missing into the offline cache (see fetch-installers.sh).
[macos]
vm-fetch:
    bash vmtest/scripts/fetch-installers.sh

# Reproduce the Windows trust-install hang (the v0.1.0 CI blocker) in the guest.
[macos]
vm-repro-trust vm="Windows 11 Pro":
    bash vmtest/scripts/vm.sh run "{{vm}}" vmtest/scripts/repro-trust-install.ps1

# Mirror the macOS VM + its cache from the internal disk to the 4 TB drive.
# VM must be powered off. Pass --dry-run / --delete through.
[macos]
vm-sync-macos *ARGS:
    bash vmtest/scripts/sync-macos-to-4tb.sh {{ARGS}}

# Copy the "Windows 11 Pro archive" (4TB) to a fast throwaway "Windows 11 Pro
# verify" on the internal SSD, for benchmarking clone speed specifically (NOT
# the same as the "Windows 11 Pro" working copy vm-test recovers automatically
# — see resolve_effective_vm in vm.sh). Bench-measured. Idempotent: removes an
# existing internal copy first. ~42 min, ~96 GB SSD write.
[macos]
vm-copy-internal:
    #!/usr/bin/env bash
    set -euo pipefail
    if prlctl list -i "Windows 11 Pro verify" >/dev/null 2>&1; then
        echo ">> removing existing internal copy first"; prlctl delete "Windows 11 Pro verify" >/dev/null 2>&1 || true
    fi
    bash vmtest/scripts/bench.sh record copy-win11-to-internal "Windows 11 Pro archive" -- \
        prlctl clone "Windows 11 Pro archive" --name "Windows 11 Pro verify" --dst "$HOME/Parallels"

# Delete the internal throwaway copy to reclaim SSD space (bench-measured).
# The canonical VM stays safe on the 4 TB external drive; re-create with
# `just vm-copy-internal`.
[macos]
vm-delete-internal:
    #!/usr/bin/env bash
    set -euo pipefail
    prlctl stop "Windows 11 Pro verify" --fast >/dev/null 2>&1 || true
    bash vmtest/scripts/bench.sh record delete-win11-internal "Windows 11 Pro verify" -- \
        prlctl delete "Windows 11 Pro verify"
