      "variant": "process",
      "variant_label": "process",
      "requires_docker": false,
      "uses_docker_compose": false,
      "path": "nodejs-typescript/process",
      "domain": "nodejs-typescript-process.portzero.local:80",
      "scripts": {
        "linux": "nodejs-typescript/process/app.ts",
        "macos": "nodejs-typescript/process/app.ts",
        "windows": "nodejs-typescript\\process\\app.ts"
      },
      "commands": {
        "linux": "PZ_TUNNEL=\"nodejs-typescript-process.portzero.local:80\" node app.ts",
        "macos": "PZ_TUNNEL=\"nodejs-typescript-process.portzero.local:80\" node app.ts",
        "windows": "$env:PZ_TUNNEL = \"nodejs-typescript-process.portzero.local:80\"; node app.ts"
      }
    },
